<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-feature android:name="android.software.leanback" android:required="false"/>
 <queries>
  <package android:name="com.google.android.youtube.tv"/>
  <package android:name="com.crunchyroll.crunchyroid"/>
  <package android:name="com.osn.go"/>
  <package android:name="com.spotify.tv.android"/>
  <package android:name="net.mbc.shahidTV"/>
 </queries>
 <application android:label="MOODE OS AI" android:theme="@android:style/Theme.Material.NoActionBar" android:usesCleartextTraffic="false">
  <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent-filter>
  </activity>
 </application>
</manifest>